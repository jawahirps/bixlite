[Unit]
Description=BIX Lite monthly Documentation review (previous treatment month, all facilities)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=ghaf
Group=ghaf
WorkingDirectory=/opt/ghaf-app/backend
Environment=TZ=Asia/Dubai
ExecStart=/bin/sh -c '/opt/ghaf-app/backend/.venv/bin/python -m scripts.doc_review_monthly >> /var/log/ghaf/doc_review.log 2>&1'
TimeoutStartSec=3h
